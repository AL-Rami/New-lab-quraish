<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>محاكاة تجربة مبدأ لوشاتلييه - ثانوية قريش</title>
    <style>
        /* التنسيقات الأساسية للصفحة */
        body {
            font-family: system-ui, -apple-system, sans-serif;
            background-color: #f1f5f9;
            color: #1e293b;
            margin: 0;
            padding: 20px;
            direction: rtl;
        }

        /* الحاوية الرئيسية */
        .card {
            max-width: 800px;
            margin: 0 auto;
            background-color: #ffffff;
            border-radius: 16px;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1);
            overflow: hidden;
            border: 1px solid #e2e8f0;
        }

        /* الهيدر / الترويسة */
        .header {
            background-color: #0f172a;
            color: #ffffff;
            padding: 20px 24px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .badge {
            background-color: rgba(16, 185, 129, 0.2);
            color: #34d399;
            font-size: 12px;
            padding: 4px 12px;
            border-radius: 9999px;
            border: 1px solid rgba(16, 185, 129, 0.3);
            font-weight: bold;
        }

        .title {
            font-size: 20px;
            font-weight: bold;
            margin: 8px 0 4px 0;
        }

        .subtitle {
            font-size: 12px;
            color: #94a3b8;
            margin: 0;
        }

        .btn-back {
            background-color: #1e293b;
            color: #e2e8f0;
            text-decoration: none;
            font-size: 12px;
            padding: 8px 16px;
            border-radius: 8px;
            transition: 0.2s;
        }

        .btn-back:hover {
            background-color: #334155;
        }

        /* شبكة محتوى التجربة */
        .content-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 24px;
            padding: 24px;
            align-items: center;
        }

        @media (max-width: 640px) {
            .content-grid {
                grid-template-columns: 1fr;
            }
        }

        /* أزرار التحكم */
        .btn-group {
            display: flex;
            gap: 12px;
            margin-top: 16px;
        }

        .btn {
            flex: 1;
            padding: 12px;
            border: none;
            border-radius: 8px;
            font-weight: bold;
            font-size: 14px;
            cursor: pointer;
            color: white;
            transition: 0.2s;
        }

        .btn-heat { background-color: #ef4444; }
        .btn-heat:hover { background-color: #dc2626; }

        .btn-cool { background-color: #3b82f6; }
        .btn-cool:hover { background-color: #2563eb; }

        .btn-reset {
            width: 100%;
            background-color: #e2e8f0;
            color: #334155;
            padding: 8px;
            border: none;
            border-radius: 8px;
            font-size: 12px;
            font-weight: bold;
            margin-top: 8px;
            cursor: pointer;
        }

        .btn-reset:hover { background-color: #cbd5e1; }

        /* مربع الملاحظة العلمية */
        .status-box {
            background-color: #f8fafc;
            border: 1px solid #e2e8f0;
            padding: 12px 16px;
            border-radius: 8px;
            margin-top: 16px;
        }

        .status-title {
            font-size: 11px;
            color: #64748b;
            font-weight: bold;
            display: block;
            margin-bottom: 4px;
        }

        .status-text {
            font-size: 13px;
            font-weight: 600;
            margin: 0;
            color: #9333ea;
        }

        /* أنبوب الاختبار */
        .lab-container {
            background-color: #0f172a;
            padding: 32px;
            border-radius: 16px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 250px;
        }

        .test-tube {
            width: 60px;
            height: 200px;
            border: 4px solid rgba(255, 255, 255, 0.3);
            border-bottom-left-radius: 30px;
            border-bottom-right-radius: 30px;
            position: relative;
            overflow: hidden;
            background-color: rgba(255, 255, 255, 0.05);
        }

        .liquid {
            position: absolute;
            bottom: 0;
            width: 100%;
            height: 75%;
            background-color: #9333ea;
            transition: background-color 0.7s ease-in-out;
        }

        .equation {
            font-family: monospace;
            font-size: 12px;
            color: #94a3b8;
            margin-top: 16px;
            direction: ltr;
        }
    </style>
</head>
<body>

    <div class="card">
        <!-- الترويسة -->
        <header class="header">
            <div>
                <span class="badge">كيمياء 2</span>
                <h1 class="title">تجربة أثر الحرارة على الاتزان (مبدأ لوشاتلييه)</h1>
                <p class="subtitle">مختبر ثانوية قريش الذكي - New-Lab-Quraish</p>
            </div>
            <a href="../index.html" class="btn-back">← العودة للمدخل</a>
        </header>

        <!-- منطقة التجربة -->
        <div class="content-grid">
            <!-- أدوات التحكم -->
            <div>
                <h2 style="font-size: 16px; font-weight: bold; margin-top: 0;">خطوات التجربة والتحكم:</h2>
                <p style="font-size: 13px; color: #475569; line-height: 1.5;">
                    اضغط على أزرار الحرارة لملاحظة تغير لون محلول كلوريد الكوبالت نتيجة انزياح موقع الاتزان:
                </p>

                <div class="btn-group">
                    <button onclick="updateTemperature('heat')" class="btn btn-heat">🔥 تسخين</button>
                    <button onclick="updateTemperature('cool')" class="btn btn-cool">❄️ تبريد</button>
                </div>

                <button onclick="updateTemperature('reset')" class="btn-reset">🔄 إعادة الاتزان الابتدائي</button>

                <div class="status-box">
                    <span class="status-title">الملاحظة العلمية:</span>
                    <p id="statusText" class="status-text">المحلول في حالة اتزان (لون بنفسجي).</p>
                </div>
            </div>

            <!-- أنبوب الاختبار التفاعلي -->
            <div class="lab-container">
                <div class="test-tube">
                    <div id="liquid" class="liquid"></div>
                </div>
                <div class="equation">[Co(H2O)6]2+ ⇌ [CoCl4]2-</div>
            </div>
        </div>
    </div>

    <!-- البرمجة التفاعلية بلغة JavaScript -->
    <script>
        function updateTemperature(action) {
            const liquid = document.getElementById('liquid');
            const statusText = document.getElementById('statusText');

            if (action === 'heat') {
                liquid.style.backgroundColor = '#2563eb';
                statusText.innerText = 'عند التسخين: يمتص التفاعل الحرارة وينزاح الاتزان نحو تكوين أيونات الكوبالت الزرقاء.';
                statusText.style.color = '#2563eb';
            } else if (action === 'cool') {
                liquid.style.backgroundColor = '#ec4899';
                statusText.innerText = 'عند التبريد: ينبعث الحرارة وينزاح الاتزان نحو تكوين أيونات الكوبالت الورديّة.';
                statusText.style.color = '#ec4899';
            } else {
                liquid.style.backgroundColor = '#9333ea';
                statusText.innerText = 'المحلول في حالة اتزان (لون بنفسجي).';
                statusText.style.color = '#9333ea';
            }
        }
    </script>

</body>
</html>
